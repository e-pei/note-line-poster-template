# このファイルを .dev.vars にコピーして値を入れる（.dev.vars は .gitignore 済み）
#   cp .dev.vars.example .dev.vars

# --- LINE（docs/onboarding-line-oa.md の手順4）---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ユーザーIDは空のままでOK。最初にメッセージを送った人を自動でオーナー登録する
LINE_OWNER_USER_ID=

# --- Claude（console.anthropic.com の従量課金APIキー。Pro/Max は規約上使用不可）---
ANTHROPIC_API_KEY=
# ワークスペースに紐づいたキーの場合のみ必要（Settings → Workspaces の wrkspc_... ）
ANTHROPIC_WORKSPACE_ID=

# --- note セッション（手動運用の逃げ道。通常は Chrome 拡張で連携する）---
# 拡張機能で連携すると、暗号化して D1 に入るのでここは空でよい
NOTE_COOKIE=
NOTE_USER_AGENT=
NOTE_URLNAME=

# --- 暗号化マスター鍵（★必須。これが無いと拡張機能からの連携ができない）---
#   生成: openssl rand -base64 32
#   本番: wrangler secret put MASTER_KEY_V1
#   ★入れ替えると保存済みの連携が読めなくなる（顧客につなぎ直しが必要になる）
MASTER_KEY_V1=
